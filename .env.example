# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Studio Admin Authentication
# Set a strong studio admin password and session signing secret before deploying.
ADMIN_PASSWORD="change-this-studio-password"
SESSION_SECRET="change-this-random-session-secret"

# Square Payment Processing (Required for real card checkout & webhook verification)
SQUARE_ENVIRONMENT="sandbox"
SQUARE_ACCESS_TOKEN="EAAA..."
SQUARE_LOCATION_ID="L..."
SQUARE_WEBHOOK_SIGNATURE_KEY="..."

# Contact Form & Transactional Email via Resend API (Server-side only)
RESEND_API_KEY="re_..."
RESEND_CUSTOMER_TEMPLATE_ID="customer-confirmation"
RESEND_OWNER_TEMPLATE_ID="owner-notification"
CONTACT_NOTIFICATION_EMAIL="owner@example.com"
EMAIL_FROM="Little Wild Things <hello@example.com>"

# Newsletter Double Opt-In via Resend Contacts & Segments (Server-side only)
RESEND_CONTACTS_API_KEY="re_..."
RESEND_NEWSLETTER_SEGMENT_ID="seg_..."
